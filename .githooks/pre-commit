#!/bin/sh
# Pre-commit hook — fast mechanical gates before a commit lands.
#   1. meta-honesty: BLOCKS if the mistake ledger has self-confirming (garbage-in) entries.
#   2. instantiation-audit --warn: surfaces declaration-over-implementation ghosts (informational).
# Activated by: git config core.hooksPath .githooks
#
# QUIET-ON-SUCCESS: on a clean commit this prints ONE summary line per gate. The full report
# (the long advisory output) is shown ONLY when a gate actually BLOCKS. Run the scripts directly
# for the full report any time: `node scripts/meta-honesty.mjs`.
ROOT="$(git rev-parse --show-toplevel)"

# ledger-schema-gate: BLOCKS if any ledger row lacks the mistake schema (date/class/
# claimed/real/caught_by) — telemetry/garbage is rejected at the ledger, not found later.
out=$(node "$ROOT/scripts/ledger-schema-gate.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by ledger-schema-gate (ledger-pollution — see rows above)."
  exit 1
fi
echo "✓ pre-commit · ledger-schema-gate: ledger schema OK"

# oracle-divergence --ratchet (2026-W35-A2): ХРАПОВИК, не тотальная блокировка.
# Прибор обязан нести КЕЙС РАСХОЖДЕНИЯ: вход, на котором измеряемая величина говорит
# «чисто», а правило нарушено. Обычные примеры («вот нарушение», «вот норма») этого не
# ловят: на них прокси и правило совпадают, тест зелёный, а прибор неверен. Режим FM-3.3
# («оракул мерит не ту величину») повторился 15 раз за 30 дней под пятнадцатью именами.
# Старый долг (22 прибора без кейса) виден и НЕ блокирует; новый прибор без кейса не проходит.
# property-vs-method (2026-W35): проверка СВОЙСТВА против проверки СПОСОБА.
# Два класса реестра — одна форма: сторож ловит УПОМЯНУТЫЙ флаг вместо совершённого
# действия (2026-08-08), тест сверяет СПОСОБ вместо обещанного свойства (2026-08-20).
# Гоняется по всему дереву движка: оно небольшое (286 файлов, доли секунды), и находок
# сегодня ноль, поэтому храповик здесь честно блокирующий, а не советующий.
out=$(node "$ROOT/scripts/property-vs-method.mjs" --repo "$ROOT" --ratchet 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by property-vs-method (проверяется способ, а не свойство — см. выше)."
  exit 1
fi
echo "✓ pre-commit · property-vs-method: проверки смотрят на свойство, не на способ"

out=$(node "$ROOT/scripts/oracle-divergence.mjs" --changed --ratchet 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by oracle-divergence (изменённый прибор без кейса расхождения — см. выше)."
  exit 1
fi
echo "✓ pre-commit · oracle-divergence: у изменённых приборов есть кейс расхождения"

out=$(node "$ROOT/scripts/meta-honesty.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by meta-honesty (ledger signal failed — see report above)."
  exit 1
fi
echo "✓ pre-commit · meta-honesty: ledger signal OK"

# instantiation-audit-hard (2026-W32-R1) — SAME SEVERITY AS CI, deliberately.
# It used to run here with --warn while .github/workflows/ci.yml runs it hard. That is a
# structural guarantee of a red main: every commit passes locally and fails on the server.
# It happened exactly that way — main went red on 2026-07-29 and stayed red through
# 2026-08-03 (four CI failures plus a failed weekly self-audit) over a one-line README
# script count, with four commits landing on top of the red, two days after the same defect
# had been "fixed". A gate that is soft where you work and hard where you publish does not
# protect you, it just moves the failure somewhere you are not looking.

# l0-normative-fingerprint (2026-W31-R5) — a normative rule must not change without the version
# moving. Three drift gates watch versions and references; none of them reads what the
# constitution SAYS, so an inverted rule used to pass all of them byte-identically.
out=$(node "$ROOT/scripts/l0-content-guard.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by l0-content-guard (норма изменена без объявления поправки — см. выше)."
  exit 1
fi
echo "✓ pre-commit · l0-content-guard: нормативные документы не менялись молча"
out=$(node "$ROOT/scripts/instantiation-audit.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-commit BLOCKED by instantiation-audit (ghost: something is declared but not on disk — see above)."
  echo "  CI runs this exact check at this exact severity, so committing would only move the failure."
  exit 1
fi
echo "✓ pre-commit · instantiation-audit: no ghosts"

# import-safety — BLOCKS if a staged .mjs does work at import time. Замер 2026-08-15:
# 86 модулей печатали при импорте, один зависал, 19 файлов репозитория переписывались
# сами. Проверяются ТОЛЬКО файлы этой правки: гейт соразмерен изменению.
staged_mjs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(scripts|hooks|lib|global-setup)/.*\.mjs$' | grep -v '__tests__' || true)
if [ -n "$staged_mjs" ]; then
  out=$(node "$ROOT/scripts/import-safety.mjs" $staged_mjs 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    echo "$out"
    echo "✗ pre-commit BLOCKED by import-safety (работа на верхнем уровне: импорт запустит её)."
    echo "  починить: node scripts/import-safety.mjs <файл> --fix"
    exit 1
  fi
  echo "✓ pre-commit · import-safety: $(echo "$staged_mjs" | wc -l | tr -d ' ') модул(ей) импортируются без последствий"
else
  echo "✓ pre-commit · import-safety: модули движка не менялись — пропуск"
fi

# clarify-gate — WARN by default: a staged master spec must have complete business-question
# coverage (clarify-engine). Soft trial; promote to --block via gate-graduation once stable.
out=$(node "$ROOT/scripts/clarify-gate.mjs" --staged 2>&1)
if echo "$out" | grep -q 'BUSINESS-QUESTION GATE'; then
  echo "$out"
  echo "↑ clarify-gate: under-elicited master spec flagged (WARN, not blocking)."
else
  echo "✓ pre-commit · clarify-gate: $(echo "$out" | tail -1)"
fi

# spec-amendment-gate — WIRED 2026-08-15 (W28-R9). It existed, self-tested 8/8, and NOTHING EVER
# CALLED IT: a gate with no caller is a file, not a defence. That disconnection is the same class
# as the orphan gates gate-audit already refuses. WARN on first wiring, per the engine's own
# soft-trial doctrine — a gate that blocks on its very first run teaches people to bypass it.
out=$(node "$ROOT/scripts/spec-amendment-gate.mjs" --staged 2>&1)
if echo "$out" | grep -qi 'violation\|amendment required'; then
  echo "$out"
  echo "↑ spec-amendment-gate: spec changed without its amendment (WARN, not blocking)."
else
  echo "✓ pre-commit · spec-amendment-gate: $(echo "$out" | tail -1)"
fi

# dup-guard — WARN by default: a new .mjs module re-declaring an existing export is a likely
# duplicate (survey-before-scaffold). Soft trial; promote to --block via gate-graduation.
out=$(node "$ROOT/scripts/dup-guard.mjs" --staged 2>&1)
if echo "$out" | grep -q 'SURVEY-BEFORE-SCAFFOLD'; then
  echo "$out"
  echo "↑ dup-guard: possible duplicate module flagged (WARN, not blocking)."
else
  echo "✓ pre-commit · dup-guard: $(echo "$out" | tail -1)"
fi

# 2026-06-10 — sentinel for --no-verify detection: post-commit treats its absence as a bypassed
# hook run and logs it to .sdd-bypass.log while hard_block_ac=true. Transient, gitignored.
echo "$$" > "$ROOT/.sdd-precommit-sentinel"
exit 0
