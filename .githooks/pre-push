#!/bin/sh
# Pre-push hook — mechanical gates before publication.
#   1. pre-publish-guard: BLOCKS the push if private data is in tree or history.
#   2. meta-audit: surfaces recurring process mistakes (informational, non-blocking).
# Activated by: git config core.hooksPath .githooks
#
# QUIET-ON-SUCCESS: a clean push prints ONE line per gate; the full report shows ONLY when a gate
# blocks (pre-publish-guard) or flags a regression (meta-audit). Full report any time:
# `node scripts/pre-publish-guard.mjs` / `node scripts/meta-audit.mjs`.
ROOT="$(git rev-parse --show-toplevel)"

out=$(node "$ROOT/scripts/pre-publish-guard.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-push BLOCKED by pre-publish-guard (secrets/PII in tree or history — see above)."
  exit 1
fi
echo "✓ pre-push · pre-publish-guard: no secrets/PII"

# ledger-sync-gate: BLOCKS if the committed learning ledger is behind the live cross-project
# inbox — otherwise every verdict downstream (meta-trend, meta-audit, the weekly scorecard)
# is computed on the optimistic half of the history. Reports n/a and passes where only one
# ledger address exists (CI, fresh clone, no global install).
out=$(node "$ROOT/scripts/ledger-sync-gate.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-push BLOCKED by ledger-sync-gate (committed ledger is behind the live one — see above)."
  exit 1
fi
echo "✓ pre-push · ledger-sync-gate: learning ledger is one source of truth"

# settings-integrity: BLOCKS if a hook in ~/.claude/settings.json points at a script that is
# not on disk, or is registered twice on the same event+matcher. A hook that cannot run still
# LOOKS like a protection in the settings file — that is the failure this catches. Reports n/a
# where there is no settings file (CI, fresh machine).
out=$(node "$ROOT/scripts/settings-integrity.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-push BLOCKED by settings-integrity (a forcing function is wired to nothing — see above)."
  exit 1
fi
echo "✓ pre-push · settings-integrity: every hook resolves"

out=$(node "$ROOT/scripts/meta-audit.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "↑ meta-audit: recurring class(es) flagged (informational, not blocking)."
else
  echo "✓ pre-push · meta-audit: no ungated recurrences"
fi

# spec-structural-gate: RATCHET — BLOCKS if the push would INCREASE broken refs /
# orphans / missing-meta above the committed ceiling. Old debt stays soft; new
# breakage is hard-blocked. Auto-tightens the ceiling when debt is paid down.
out=$(node "$ROOT/scripts/spec-structural-gate.mjs" 2>&1); rc=$?
if [ $rc -ne 0 ]; then
  echo "$out"
  echo "✗ pre-push BLOCKED by spec-structural-gate (new spec-tree breakage — see above)."
  exit 1
fi
echo "✓ pre-push · spec-structural-gate: no new spec-tree breakage"
exit 0
